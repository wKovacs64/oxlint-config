{
  "name": "@wkovacs64/oxlint-config",
  "version": "0.1.0",
  "private": false,
  "description": "@wKovacs64 Oxlint config",
  "keywords": [
    "oxc",
    "oxlint",
    "oxlint-config",
    "wkovacs64"
  ],
  "homepage": "https://github.com/wKovacs64/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/wKovacs64/oxlint-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wKovacs64/oxlint-config.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "plugins/module-boundaries.js"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "node ./scripts/smoke.mjs",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@types/react": "19.2.18",
    "@wkovacs64/oxfmt-config": "1.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "oxlint": ">=1.70.0 <2",
    "oxlint-tsgolint": ">=7.0.2001"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
